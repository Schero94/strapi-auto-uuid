{
  "name": "strapi-auto-uuid-v5",
  "version": "2.1.1",
  "description": "Strapi 5 custom field that generates UUID v4 or v7 values on the server, keeps them unique and locked, and adds admin tools to check, repair, export and import them.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-5",
    "strapi-v5",
    "strapi-custom-field",
    "custom-field",
    "uuid",
    "uuid-v4",
    "uuid-v7",
    "uuidv7",
    "unique-identifier",
    "content-type"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.js",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist/",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "npm run lint",
    "build": "strapi-plugin build && npm run verify:bundle",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:concurrency": "node --import ./scripts/esm-source-hooks.mjs scripts/concurrency-check.mjs"
  },
  "dependencies": {
    "@strapi/utils": "^5.24.0",
    "uuid": "^14.0.3",
    "yup": "0.32.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@strapi/database": "^5.61.0",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "semantic-release": "^25.0.9",
    "styled-components": "^6.6.0",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.24.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/design-system": {
      "optional": true
    },
    "@strapi/icons": {
      "optional": true
    },
    "react-intl": {
      "optional": true
    }
  },
  "overrides": {
    "zod@4.4.3": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12.0 <=26.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "field-uuid",
    "displayName": "Auto UUID",
    "description": "Generates UUID v4 or v7 values for a custom field and adds tools to check, repair, export and import them"
  },
  "license": "MIT",
  "author": "Cringe Studio / Schero D. <schero1894@gmail.com>",
  "homepage": "https://schero94.github.io/strapi-auto-uuid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Schero94/strapi-auto-uuid.git"
  },
  "bugs": {
    "url": "https://github.com/Schero94/strapi-auto-uuid/issues"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
